# Core
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna            # the model used during development; any OpenAI chat model with structured output works
# EMBEDDING_MODEL=text-embedding-3-small   # optional; must produce 1536-dim vectors (db/schema.sql)
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # server-side secret key (never expose it to the frontend)
DATABASE_URL=                 # Supabase session pooler (used for the checkpointer and DB patches)
FRONTEND_ORIGIN=http://localhost:3000
WISPR_MCP_URL=https://api.wisprflow.ai/connect/mcp

# Switches
USE_SUPABASE_STORE=true
USE_POSTGRES_CHECKPOINTER=true
USE_REAL_INTEGRATIONS=false   # false = dry-run executor (nothing is sent); true = really post to Notion/Slack/email
SCHEDULER_ENABLED=true

# Integrations (only needed when USE_REAL_INTEGRATIONS=true)
NOTION_TOKEN=
NOTION_TASKS_DATA_SOURCE_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_USER_ID_SHREY=          # fallback DM target if the bot is not in SLACK_CHANNEL_ID
RESEND_API_KEY=
RESEND_FROM=                  # optional; defaults to onboarding@resend.dev
RESEND_TEST_RECIPIENT=        # onboarding sender only delivers to the account owner
